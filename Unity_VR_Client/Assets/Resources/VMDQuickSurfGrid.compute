// QuickSurf on the GPU: a Gaussian density grid like VMD's QuickSurf, then marching
// tetrahedra. Vertices stay in VMD coordinates; the draw shader applies the view.
//
// VMDQuickSurfScene.Build runs the three kernels in order for one surface and
// one frame: ClearGrid zeroes the grid and the triangle counter, SplatAtoms
// adds every atom's density and color to the grid, and BuildSurface writes
// the isosurface triangles to _Vertices, which VMDQuickSurf.shader draws.
#pragma kernel ClearGrid
#pragma kernel SplatAtoms
#pragma kernel BuildSurface

// Fixed-point scale for portable integer atomics (float atomics are not universal).
#define DENSITY_SCALE 65536.0

// Atom mirrors GpuAtom in VMDQuickSurfScene (32 bytes). SurfaceVertex (28 bytes)
// is declared again in VMDQuickSurf.shader; its color is RGBA8 as packed by Pack.
struct Atom { float3 position; float invTwoSigma2; float3 color; float cutoff; };
struct SurfaceVertex { float3 position; float3 normal; uint color; };

// _Density holds one fixed-point density per grid point. _Counter[0]
// counts the triangles of the current build, including those that did
// not fit in _Vertices. _Vertices holds three vertices per triangle.
StructuredBuffer<Atom> _Atoms;
RWStructuredBuffer<uint> _Density;
RWStructuredBuffer<uint> _ColorSum; // Three density-weighted channels per grid point.
RWStructuredBuffer<uint> _Counter;
RWStructuredBuffer<SurfaceVertex> _Vertices;

// _CellCount: grid points in total. _ThreadCount: threads dispatched for ClearGrid.
// _Capacity: triangles that fit in _Vertices. _DimX, _DimY, _DimZ: grid points per axis.
// _Spacing: distance between grid points. _Origin: position of grid
// point (0, 0, 0). Positions and lengths are in VMD coordinates.
uint _AtomCount, _CellCount, _ThreadCount, _Capacity;
uint _DimX, _DimY, _DimZ;
float _Spacing, _Isovalue;
float4 _Origin;

// Corner[k] is the grid offset of cube corner k, and Tetra lists the four corners of each of
// six tetrahedra. This is the Freudenthal split of a cube around the 0-6 diagonal. Every cube
// is split the same way, so neighboring cubes share face diagonals and edges (no cracks).
static const int3 Corner[8] = { int3(0,0,0), int3(1,0,0), int3(1,1,0), int3(0,1,0),
                                int3(0,0,1), int3(1,0,1), int3(1,1,1), int3(0,1,1) };
static const uint Tetra[24] = { 0,5,1,6, 0,1,2,6, 0,2,3,6, 0,3,7,6, 0,7,4,6, 0,4,5,6 };

// Cell: index of a grid point in the buffers. Clamp: the nearest grid point inside the grid.
// Density: the density at a grid point, converted back from fixed point.
uint Cell(int3 c) { return (uint)c.x + _DimX * ((uint)c.y + _DimY * (uint)c.z); }
int3 Clamp(int3 c) { return clamp(c, int3(0,0,0), int3(_DimX, _DimY, _DimZ) - 1); }
float Density(int3 c) { return _Density[Cell(Clamp(c))] / DENSITY_SCALE; }

// Zero the density, the color sums and the triangle counter. Thread i clears the grid points
// i, i + _ThreadCount, i + 2 * _ThreadCount and so on, so a grid of any size is covered.
[numthreads(256,1,1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    for (uint i = id.x; i < _CellCount; i += _ThreadCount)
    {
        _Density[i] = 0;
        _ColorSum[i*3] = 0; _ColorSum[i*3+1] = 0; _ColorSum[i*3+2] = 0;
    }
    if (id.x == 0) _Counter[0] = 0;
}

// One thread per atom: add the atom's Gaussian density, and its color
// weighted by that density, to every grid point within the atom's cutoff. The
// adds are interlocked because several atoms write to the same grid point.
[numthreads(64,1,1)]
void SplatAtoms(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _AtomCount) return;
    Atom atom = _Atoms[id.x];
    float3 grid = (atom.position - _Origin.xyz) / _Spacing;
    float reach = atom.cutoff / _Spacing;
    int3 low = max(int3(ceil(grid - reach)), int3(0,0,0));
    int3 high = min(int3(floor(grid + reach)), int3(_DimX, _DimY, _DimZ) - 1);
    float cutoff2 = atom.cutoff * atom.cutoff;
    for (int z = low.z; z <= high.z; z++)
    for (int y = low.y; y <= high.y; y++)
    for (int x = low.x; x <= high.x; x++)
    {
        float3 offset = _Origin.xyz + float3(x, y, z) * _Spacing - atom.position;
        float r2 = dot(offset, offset);
        if (r2 > cutoff2) continue;
        float density = exp(-r2 * atom.invTwoSigma2);
        uint quantized = (uint)(density * DENSITY_SCALE + 0.5);
        if (quantized == 0) continue;
        uint cell = Cell(int3(x, y, z));
        float3 weighted = density * saturate(atom.color) * DENSITY_SCALE + 0.5;
        InterlockedAdd(_Density[cell], quantized);
        InterlockedAdd(_ColorSum[cell*3], (uint)weighted.r);
        InterlockedAdd(_ColorSum[cell*3+1], (uint)weighted.g);
        InterlockedAdd(_ColorSum[cell*3+2], (uint)weighted.b);
    }
}

// Density gradient by central differences, clamped at the grid border.
// It is only used for normals, so it is not divided by the spacing.
float3 Gradient(int3 c)
{
    return float3(Density(c + int3(1,0,0)) - Density(c - int3(1,0,0)),
                  Density(c + int3(0,1,0)) - Density(c - int3(0,1,0)),
                  Density(c + int3(0,0,1)) - Density(c - int3(0,0,1)));
}

// Density-weighted mean color of the atoms at a grid point; white where there is no density.
float3 AtomColor(int3 c)
{
    uint cell = Cell(c);
    uint weight = _Density[cell];
    if (weight == 0) return float3(1,1,1);
    return float3(_ColorSum[cell*3], _ColorSum[cell*3+1], _ColorSum[cell*3+2]) / weight;
}

// RGBA8 in one uint: red in the lowest byte, alpha 255.
uint Pack(float3 color)
{
    uint3 bytes = (uint3)(saturate(color) * 255.0 + 0.5);
    return bytes.x | (bytes.y << 8) | (bytes.z << 16) | (255u << 24);
}

// State of the cube that a BuildSurface thread works on: its lowest
// corner, and the density, gradient and color at its eight corners.
static int3 baseCell;
static float value[8];
static float3 gradient[8];
static float3 tint[8];

// Vertex where the isosurface crosses the cube edge between corners i and
// j. Position, gradient and color are interpolated linearly along the edge.
SurfaceVertex Edge(uint i, uint j)
{
    float t = saturate((_Isovalue - value[i]) / (value[j] - value[i]));
    SurfaceVertex v;
    v.position = _Origin.xyz + lerp(float3(baseCell + Corner[i]), float3(baseCell + Corner[j]), t) * _Spacing;
    float3 g = lerp(gradient[i], gradient[j], t);
    // Density decreases outward, so the outward normal is the negative gradient.
    v.normal = dot(g, g) > 1e-20 ? -normalize(g) : float3(0,0,0);
    v.color = Pack(lerp(tint[i], tint[j], t));
    return v;
}

// Append one triangle to _Vertices. Degenerate triangles are skipped, and a vertex
// without a usable gradient gets the face normal. The winding is not made consistent;
// VMDQuickSurf.shader draws both faces and turns the normal toward the camera.
void Emit(SurfaceVertex a, SurfaceVertex b, SurfaceVertex c)
{
    float3 face = cross(b.position - a.position, c.position - a.position);
    if (dot(face, face) < 1e-24) return;
    face = normalize(face);
    if (dot(a.normal, a.normal) == 0) a.normal = face;
    if (dot(b.normal, b.normal) == 0) b.normal = face;
    if (dot(c.normal, c.normal) == 0) c.normal = face;
    uint slot;
    InterlockedAdd(_Counter[0], 1, slot);
    // The CPU grows the buffer and rebuilds when the count exceeds the capacity.
    if (slot >= _Capacity) return;
    _Vertices[slot*3] = a; _Vertices[slot*3+1] = b; _Vertices[slot*3+2] = c;
}

// One thread per grid cube, whose lowest corner is grid point 'id'. A cube that the
// surface does not cross is skipped. Otherwise it is split into six tetrahedra, and
// each tetrahedron that the surface crosses emits one or two triangles, depending on
// which of its corners are inside the surface (density at or above the isovalue).
[numthreads(4,4,4)]
void BuildSurface(uint3 id : SV_DispatchThreadID)
{
    // The dispatch is rounded up to whole thread groups, so some threads lie outside the grid.
    if (id.x + 1 >= _DimX || id.y + 1 >= _DimY || id.z + 1 >= _DimZ) return;
    baseCell = int3(id);
    uint inside = 0;
    for (uint k = 0; k < 8; k++)
    {
        value[k] = Density(baseCell + Corner[k]);
        if (value[k] >= _Isovalue) inside++;
    }
    if (inside == 0 || inside == 8) return;
    for (uint n = 0; n < 8; n++)
    {
        gradient[n] = Gradient(baseCell + Corner[n]);
        tint[n] = AtomColor(baseCell + Corner[n]);
    }
    for (uint t = 0; t < 6; t++)
    {
        uint corner[4] = { Tetra[t*4], Tetra[t*4+1], Tetra[t*4+2], Tetra[t*4+3] };
        uint mask = 0;
        for (uint m = 0; m < 4; m++) if (value[corner[m]] >= _Isovalue) mask |= 1u << m;
        if (mask == 0 || mask == 15) continue;
        uint count = countbits(mask);
        if (count != 2)
        {
            // One corner differs from the other three: a single triangle around it.
            uint lone = firstbitlow(count == 1 ? mask : (~mask & 15));
            uint other[3];
            uint o = 0;
            for (uint q = 0; q < 4; q++) if (q != lone) other[o++] = q;
            Emit(Edge(corner[lone], corner[other[0]]), Edge(corner[lone], corner[other[1]]),
                 Edge(corner[lone], corner[other[2]]));
        }
        else
        {
            // Two inside (a, b) and two outside (c, d): a quad split into two triangles.
            uint a = firstbitlow(mask), b = firstbithigh(mask);
            uint outsideMask = ~mask & 15;
            uint c = firstbitlow(outsideMask), d = firstbithigh(outsideMask);
            SurfaceVertex ac = Edge(corner[a], corner[c]), ad = Edge(corner[a], corner[d]);
            SurfaceVertex bd = Edge(corner[b], corner[d]), bc = Edge(corner[b], corner[c]);
            Emit(ac, ad, bd);
            Emit(ac, bd, bc);
        }
    }
}
