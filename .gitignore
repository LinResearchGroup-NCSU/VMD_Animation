/VMD_VR_Bridge/.vrbridge_test_*.pdb
/.vrbridge_test_*.pdb

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
/Unity_VR_Client/.vscode/

# Unity scene recovery and diagnostic output
/Unity_VR_Client/Assets/_Recovery/
/Unity_VR_Client/Assets/_Recovery.meta
/Unity_VR_Client/Assets/__Backupscenes/
/Unity_VR_Client/Assets/__Backupscenes.meta
